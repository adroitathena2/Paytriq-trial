# Copy to .env (never commit .env). Restart uvicorn after editing.
# Only GEMINI_API_KEY is needed to go "live" — rest are optional, mocks stay as fallback.

# 1) Gemini (A1 icebreaker, A2 cover letter, A6 vision). Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2) Google Maps Places (A1 live brand search instead of 12-shop cache)
GOOGLE_MAPS_KEY=

# 3) Gmail real send via App Password (else mails go to outbox/*.txt mock)
# Enable 2-Step Verification → https://myaccount.google.com/apppasswords → 16-letter password
GMAIL_USER=
GMAIL_APP_PASSWORD=
